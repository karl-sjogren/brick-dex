{
  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/tmp": true,
    "**/.yarn/cache": true,
    ".vs/": true
  },
  "dotnet.defaultSolution": "BrickDex.slnx",
