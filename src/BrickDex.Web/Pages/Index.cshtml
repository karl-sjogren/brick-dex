@page
@using BrickDex.Core.Models
@model IndexModel
@{
    ViewData["Title"] = "Home";

    string GetStatusDisplayName(SetStatus status) => status switch {
        SetStatus.None => "No Status",
        SetStatus.InStorage => "In Storage",
        _ => status.ToString()
    };
}

<div class="hero">
    <h1>Welcome to <span class="text-yellow">Brick</span>Dex</h1>
    <p class="lead">Manage your LEGO collection with ease</p>
</div>

@if(Model.IsAuthenticated) {
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalSets</div>
            <div class="stat-label">Sets in Collection</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@Model.TotalParts</div>
            <div class="stat-label">Total Parts</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@Model.WishlistCount</div>
            <div class="stat-label">On Wishlist</div>
        </div>
    </div>

    <div class="quick-actions">
        <h2>Quick Actions</h2>
        <div class="action-buttons">
            <a asp-page="/Sets/Search" class="btn btn-primary">Add New Set</a>
            <a asp-page="/Sets/Index" class="btn btn-secondary">View Collection</a>
            <a asp-page="/Sets/Wishlist" class="btn btn-secondary">View Wishlist</a>
        </div>
    </div>

    @if(Model.RecentSets.Count > 0) {
        <div class="recent-sets">
            <h2>Recently Added</h2>
            <div class="sets-grid">
                @foreach(var userSet in Model.RecentSets) {
                    var statusClass = userSet.Status != SetStatus.None ? $"has-status status-{userSet.Status.ToString().ToLowerInvariant()}" : "";
                    <div class="set-card @statusClass">
                        <a asp-page="/Sets/Details" asp-route-id="@userSet.Id" class="set-card-link-area">
                            <div class="set-image-wrapper">
                                @if(!string.IsNullOrEmpty(userSet.Set.ImageUrl)) {
                                    <picture>
                                        <source media="(max-width: 480px)" srcset="@userSet.Set.ImageUrl.ToThumbnail(150, 150)">
                                        <source media="(max-width: 768px)" srcset="@userSet.Set.ImageUrl.ToThumbnail(200, 200)">
                                        <img src="@userSet.Set.ImageUrl.ToThumbnail(250, 250)" alt="@userSet.Set.Name" class="set-image" loading="lazy" />
                                    </picture>
                                } else {
                                    <div class="set-image-placeholder">
                                        <span>No Image</span>
                                    </div>
                                }
                            </div>
                            <div class="set-info">
                                <h3>@userSet.Set.Name</h3>
                                <p class="set-number">@userSet.SetNumber</p>
                                <p class="set-details">@userSet.Set.Year &bull; @userSet.Set.NumParts parts</p>
                                @if(userSet.Set.Theme != null) {
                                    <p class="set-theme">@userSet.Set.Theme.Name</p>
                                }
                            </div>
                        </a>
                        <div class="status-dropdown" data-user-set-id="@userSet.Id" data-current-status="@((int)userSet.Status)">
                            <button type="button" class="status-badge status-@userSet.Status.ToString().ToLowerInvariant()">
                                @GetStatusDisplayName(userSet.Status)
                                <span class="dropdown-arrow">▼</span>
                            </button>
                            <div class="status-dropdown-menu">
                                @foreach(var status in Enum.GetValues<SetStatus>()) {
                                    <button type="button"
                                            class="status-option status-@status.ToString().ToLowerInvariant() @(status == userSet.Status ? "selected" : "")"
                                            data-status="@((int)status)">
                                        @GetStatusDisplayName(status)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
} else {
    <div class="welcome-cta">
        <p>Sign in to start managing your LEGO collection!</p>
        <div class="login-providers">
            @if(Model.GoogleEnabled) {
                <form method="post" asp-page-handler="Google">
                    <button type="submit" class="btn btn-google">Sign in with Google</button>
                </form>
            }
            @if(Model.GitHubEnabled) {
                <form method="post" asp-page-handler="GitHub">
                    <button type="submit" class="btn btn-github">Sign in with GitHub</button>
                </form>
            }
            @if(Model.IsDevelopment) {
                <a asp-page="/Account/DevLogin" class="btn btn-dev">Sign in as Dev User</a>
            }
        </div>
    </div>
}
