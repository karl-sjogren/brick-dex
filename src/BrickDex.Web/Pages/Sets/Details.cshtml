@page "{id:guid}"
@model BrickDex.Web.Pages.Sets.DetailsModel
@{
    ViewData["Title"] = Model.UserSet?.Set?.Name ?? "Set Details";
}

@if(Model.UserSet == null) {
    <div class="error-state">
        <h1>Set Not Found</h1>
        <p>The requested set could not be found.</p>
        <a asp-page="/Sets/Index" class="btn btn-primary">Back to Collection</a>
    </div>
} else {
    <div class="set-details">
        <div class="set-header">
            @if(Model.UserSet.IsWishlist) {
                <a asp-page="/Sets/Wishlist" class="back-link">&larr; Back to Wishlist</a>
            } else {
                <a asp-page="/Sets/Index" class="back-link">&larr; Back to Collection</a>
            }
            <h1>@Model.UserSet.Set.Name</h1>
        </div>

        <div class="set-details-grid">
            <div class="set-image-container">
                @if(!string.IsNullOrEmpty(Model.UserSet.Set.ImageUrl)) {
                    <picture>
                        <source media="(max-width: 480px)" srcset="@Model.UserSet.Set.ImageUrl.ToThumbnail(250, 250)">
                        <source media="(max-width: 768px)" srcset="@Model.UserSet.Set.ImageUrl.ToThumbnail(300, 300)">
                        <img src="@Model.UserSet.Set.ImageUrl.ToThumbnail(400, 400)" alt="@Model.UserSet.Set.Name" class="set-detail-image" />
                    </picture>
                } else {
                    <div class="set-image-placeholder">
                        <span>No Image</span>
                    </div>
                }
            </div>

            <div class="set-info-panel">
                <dl class="set-attributes">
                    <dt>Set Number</dt>
                    <dd>@Model.UserSet.SetNumber</dd>

                    <dt>Year</dt>
                    <dd>@Model.UserSet.Set.Year</dd>

                    <dt>Parts</dt>
                    <dd>@Model.UserSet.Set.NumParts</dd>

                    @if(Model.UserSet.Set.Theme != null) {
                        <dt>Theme</dt>
                        <dd>@Model.UserSet.Set.Theme.Name</dd>
                    }

                    <dt>Quantity</dt>
                    <dd>@Model.UserSet.Quantity</dd>
                </dl>

                <div class="set-external-links">
                    <a href="https://rebrickable.com/sets/@Model.UserSet.SetNumber/" target="_blank" rel="noopener" class="btn btn-secondary">View on Rebrickable</a>
                    <a href="https://www.lego.com/product/@Model.UserSet.SetNumber.Split('-')[0]" target="_blank" rel="noopener" class="btn btn-secondary">View on LEGO.com</a>
                </div>
            </div>
        </div>

        @{
            // Use the first inventory (primary version) to avoid duplicates from multiple versions
            var primaryInventory = Model.UserSet.Set.Inventories
                .OrderBy(i => i.Version)
                .FirstOrDefault();

            var minifigs = primaryInventory?.InventoryMinifigs
                .Where(im => im.Minifig != null)
                .OrderBy(im => im.Minifig!.Name)
                .ToList() ?? [];

            var totalCount = minifigs.Sum(m => m.Quantity);
        }

        @if(minifigs.Count > 0) {
            <div class="set-minifigs">
                <h2>Minifigures (@totalCount)</h2>
                <div class="minifigs-grid">
                    @foreach(var item in minifigs) {
                        var minifig = item.Minifig!;
                        <div class="minifig-card">
                            @if(item.Quantity > 1) {
                                <span class="minifig-qty-badge">×@item.Quantity</span>
                            }
                            @if(!string.IsNullOrEmpty(minifig.ImageUrl)) {
                                <img src="@minifig.ImageUrl.ToThumbnail(150, 150)"
                                     alt="@minifig.Name"
                                     class="minifig-image"
                                     loading="lazy" />
                            } else {
                                <div class="minifig-image-placeholder">
                                    <span>No Image</span>
                                </div>
                            }
                            <div class="minifig-info">
                                <span class="minifig-name">@minifig.Name</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="set-edit-form">
            <h2>Edit Set</h2>
            <form method="post">
                <input type="hidden" asp-for="UserSet.Id" />

                <div class="form-group">
                    <label asp-for="UserSet.Quantity">Quantity</label>
                    <input type="number" asp-for="UserSet.Quantity" min="1" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="UserSet.Notes">Notes</label>
                    <textarea asp-for="UserSet.Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="UserSet.Status">Status</label>
                    <select asp-for="UserSet.Status" asp-items="Html.GetEnumSelectList<BrickDex.Core.Models.SetStatus>()" class="form-control"></select>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" asp-for="UserSet.IsWishlist" />
                        In Wishlist
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.UserSet.Id" class="delete-form">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this set?')">Delete</button>
            </form>
        </div>
    </div>
}
