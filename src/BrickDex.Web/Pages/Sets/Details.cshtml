@page "{id:guid}"
@model BrickDex.Web.Pages.Sets.DetailsModel
@{
    ViewData["Title"] = Model.Set?.Name ?? "Set Details";
}

@if(Model.Set == null) {
    <div class="error-state">
        <h1>Set Not Found</h1>
        <p>The requested set could not be found.</p>
        <a asp-page="/Sets/Index" class="btn btn-primary">Back to Collection</a>
    </div>
} else {
    <div class="set-details">
        <div class="set-header">
            <a asp-page="/Sets/Index" class="back-link">&larr; Back to Collection</a>
            <h1>@Model.Set.Name</h1>
        </div>

        <div class="set-details-grid">
            <div class="set-image-container">
                @if(!string.IsNullOrEmpty(Model.Set.ImageUrl)) {
                    <img src="@Model.Set.ImageUrl" alt="@Model.Set.Name" class="set-detail-image" />
                }
            </div>

            <div class="set-info-panel">
                <dl class="set-attributes">
                    <dt>Set Number</dt>
                    <dd>@Model.Set.SetNumber</dd>

                    <dt>Year</dt>
                    <dd>@Model.Set.Year</dd>

                    <dt>Parts</dt>
                    <dd>@Model.Set.NumParts</dd>

                    @if(!string.IsNullOrEmpty(Model.Set.ThemeName)) {
                        <dt>Theme</dt>
                        <dd>@Model.Set.ThemeName</dd>
                    }

                    <dt>Quantity</dt>
                    <dd>@Model.Set.Quantity</dd>
                </dl>

                @if(!string.IsNullOrEmpty(Model.Set.SetUrl)) {
                    <a href="@Model.Set.SetUrl" target="_blank" rel="noopener" class="btn btn-secondary">View on Rebrickable</a>
                }
            </div>
        </div>

        <div class="set-edit-form">
            <h2>Edit Set</h2>
            <form method="post">
                <input type="hidden" asp-for="Set.Id" />

                <div class="form-group">
                    <label asp-for="Set.Quantity">Quantity</label>
                    <input type="number" asp-for="Set.Quantity" min="1" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Set.Notes">Notes</label>
                    <textarea asp-for="Set.Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="Set.Status">Status</label>
                    <select asp-for="Set.Status" asp-items="Html.GetEnumSelectList<BrickDex.Core.Models.SetStatus>()" class="form-control"></select>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" asp-for="Set.IsWishlist" />
                        In Wishlist
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <form method="post" asp-page-handler="Delete" style="display: inline;">
                        <input type="hidden" name="id" value="@Model.Set.Id" />
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this set?')">Delete</button>
                    </form>
                </div>
            </form>
        </div>
    </div>
}
