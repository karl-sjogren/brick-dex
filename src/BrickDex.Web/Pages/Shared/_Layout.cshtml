@inject Shorthand.Vite.Contracts.IViteService Vite
@inject TimeProvider TimeProvider
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrickDex</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="@await Vite.GetAssetUrlAsync("style.css")" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <img src="/images/logo.svg" alt="BrickDex" height="36" />
                </a>
                @if(User.Identity?.IsAuthenticated == true) {
                    <button class="navbar-toggler" type="button" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Sets/Index">My Collection</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Sets/Wishlist">Wishlist</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Sets/Search">Search</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Invites">Invite Friends</a>
                            </li>
                        </ul>
                        <div class="navbar-user">
                            <span class="user-name">@User.Identity.Name</span>
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn-signout">Sign Out</button>
                            </form>
                        </div>
                    </div>
                } else {
                    <a class="btn btn-primary" asp-page="/Account/Login">Sign In</a>
                }
            </div>
        </nav>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; @TimeProvider.GetUtcNow().Year - BrickDex</p>
        </div>
    </footer>

    <script src="@await Vite.GetAssetUrlAsync("scripts/index.mjs")" type="module"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
